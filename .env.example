# ========================================================
# HiTech E-Commerce Platform — Environment Variables
# Copy this file to .env or .env.local and fill in the values.
# ========================================================

# --- Supabase PostgreSQL Database ---
# Get from: https://supabase.com/dashboard/project/<project-ref>/settings/api-keys
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --- Cloudinary Media CDN ---
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
CLOUDINARY_PRODUCTS_PRESET=hitech_products_unsigned
CLOUDINARY_OFFERS_PRESET=hitech_offers_unsigned

# --- Super Admin Credentials ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<sha256-hash-of-admin-password>

# --- Resend Transactional Email ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_TO_EMAIL=hitechmobilesandservice@gmail.com
RESEND_FROM_EMAIL=HiTech <onboarding@resend.dev>

# --- Vercel & GitHub CI/CD Tokens (Optional / Local Automation) ---
GITHUB_TOKEN=
VERCEL_TOKEN=
